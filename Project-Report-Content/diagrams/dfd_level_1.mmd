flowchart TB
    %% DFD Level 1 - Detailed Process Decomposition
    %% CRM System: Lead, Customer, Order & Subscription Management
    
    %% External Entities
    E1["💼 Sales Executive<br/>(Partner/Marketing/Admin)"]
    E2["📧 Email Service"]
    
    %% Data Stores
    D1[("D1: Users")]
    D2[("D2: Leads")]
    D3[("D3: LeadHistory")]
    D4[("D4: Customers")]
    D5[("D5: ProductVariants")]
    D6[("D6: Orders")]
    D7[("D7: Subscriptions")]
    D8[("D8: SubscriptionHistory")]
    D9[("D9: Activities")]
    D10[("D10: Notifications")]
    D11[("D11: PasswordReset/OTP")]
    D12[("D12: Audit Trail")]
    
    %% Core Processes
    P1["🔐 P1: Authentication<br/>& User Management"]
    P2["📋 P2: Lead<br/>Management"]
    P3["👤 P3: Customer<br/>Management"]
    P4["📦 P4: Order<br/>Management"]
    P5["🔄 P5: Subscription<br/>Management"]
    P6["💳 P6: Product<br/>Variant Management"]
    P7["🔔 P7: Activity & Event<br/>Tracking"]
    P8["📬 P8: Notification<br/>Service"]
    P9["📊 P9: Dashboard &<br/>Reporting"]
    P10["💾 P10: Data Export<br/>& Reporting"]
    P11["⏰ P11: Background<br/>Scheduler"]
    
    %% ===== AUTHENTICATION (P1) =====
    E1 -->|"1.1: Login"| P1
    P1 -->|"1.2: Token"| E1
    P1 <-->|"1.3: User data"| D1
    P1 <-->|"1.4: OTP"| D11
    P1 -->|"1.5: OTP email"| E2
    P1 -->|"1.6: Log login"| P7
    
    %% ===== LEAD MANAGEMENT (P2) =====
    E1 -->|"2.1: Lead CRUD"| P2
    P2 -->|"2.2: Lead data"| E1
    P2 <-->|"2.3: Leads"| D2
    P2 <-->|"2.4: Lead history"| D3
    P2 -->|"2.5: Log activity"| P7
    P2 -.->|"2.6: Read (Dashboard)"| P9
    
    %% ===== CUSTOMER MANAGEMENT (P3) =====
    E1 -->|"3.1: Customer CRUD"| P3
    P3 -->|"3.2: Customer data"| E1
    P3 <-->|"3.3: Customers"| D4
    P3 -->|"3.4: Log activity"| P7
    P3 -.->|"3.5: Read (Dashboard)"| P9
    
    %% ===== ORDER MANAGEMENT (P4) =====
    E1 -->|"4.1: Order CRUD"| P4
    P4 -->|"4.2: Order data"| E1
    P4 <-->|"4.3: Orders"| D6
    P4 -->|"4.4: Create subscription"| P5
    P4 -->|"4.5: Log activity"| P7
    P4 -.->|"4.6: Read (Dashboard)"| P9
    P4 -->|"4.7: Log event"| D9
    
    %% ===== SUBSCRIPTION MANAGEMENT (P5) =====
    P4 -->|"5.1: New subscription"| P5
    E1 -->|"5.2: Manage subs"| P5
    P5 -->|"5.3: Subscription data"| E1
    P5 <-->|"5.4: Subscriptions"| D7
    P5 <-->|"5.5: Sub history"| D8
    P5 -->|"5.6: Log activity"| P7
    P5 -->|"5.7: Renewal event"| P7
    P11 -->|"5.8: Check expiry"| P5
    P5 -->|"5.9: Expiry alert"| P8
    P5 -.->|"5.10: Read (Dashboard)"| P9
    
    %% ===== PRODUCT VARIANT (P6) =====
    E1 -->|"6.1: View products"| P6
    P6 -->|"6.2: Product data"| E1
    P6 <-->|"6.3: ProductVariants"| D5
    P4 -->|"6.4: Product price"| P6
    
    %% ===== ACTIVITY TRACKING (P7) =====
    P1 -->|"7.1: Auth events"| P7
    P2 -->|"7.2: Lead events"| P7
    P3 -->|"7.3: Customer events"| P7
    P4 -->|"7.4: Order events"| P7
    P5 -->|"7.5: Sub events"| P7
    P7 <-->|"7.6: Activity log"| D9
    P7 -->|"7.7: Log audit"| D12
    P7 -->|"7.8: Trigger notification"| P8
    
    %% ===== NOTIFICATION SERVICE (P8) =====
    P7 -->|"8.1: Event"| P8
    P5 -->|"8.2: Renewal event"| P8
    P8 <-->|"8.3: Notifications"| D10
    P8 -->|"8.4: Send email"| E2
    P8 -->|"8.5: In-app notify"| E1
    
    %% ===== DASHBOARD (P9) =====
    E1 -->|"9.1: View dashboard"| P9
    P9 -->|"9.2: Stats & metrics"| E1
    P9 -.->|"9.3: Read all data"| D2
    P9 -.->|"9.4: Read"| D3
    P9 -.->|"9.5: Read"| D4
    P9 -.->|"9.6: Read"| D6
    P9 -.->|"9.7: Read"| D7
    P9 -.->|"9.8: Read"| D9
    P9 -.->|"9.9: Commission calc"| D6
    
    %% ===== EXPORT (P10) =====
    E1 -->|"10.1: Export profile"| P10
    P10 -->|"10.2: ZIP file"| E1
    P10 -.->|"10.3: Read leads"| D2
    P10 -.->|"10.4: Read customers"| D4
    P10 -.->|"10.5: Read orders"| D6
    P10 -.->|"10.6: Read subs"| D7
    P10 -.->|"10.7: Read products"| D5
    P10 -.->|"10.8: CSV export"| D6
    
    %% ===== BACKGROUND SCHEDULER (P11) =====
    P11 -->|"11.1: Hourly check"| P5
    P5 -->|"11.2: Expiry data"| P11
    P11 -->|"11.3: Trigger"| P8
    
